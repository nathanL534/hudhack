# ─────────────────────────────────────────────────────────────────────────────
# hudhack — sponsor service credentials (TEMPLATE — copy to .env, then fill in)
#
#   cp .env.example .env   &&   edit .env with real keys (.env is gitignored)
#
# CLI install + auth one-liners per service:
#
#   Fireworks  CLI: firectl  ·  SDK: fireworks-ai, eval-protocol
#     install : brew tap fw-ai/firectl && brew install firectl   (CLI)
#               pip install --pre fireworks-ai eval-protocol      (Python SDKs)
#     auth    : firectl signin            (browser SSO; or pass --api-key per cmd)
#               export FIREWORKS_API_KEY=fw_...   (SDK reads this env var)
#     verify  : firectl whoami
#
#   Modal      CLI: modal
#     install : pip install modal
#     auth    : modal token new           (or: modal setup — both do browser auth,
#               writes ~/.modal.toml)      and write ~/.modal.toml)
#     CI/env  : export MODAL_TOKEN_ID=ak-...  MODAL_TOKEN_SECRET=as-...
#
#   HUD        CLI: hud   ·  SDK: hud-python
#     install : uv tool install hud-python --python 3.12   (or: pip install hud-python)
#     auth    : hud set HUD_API_KEY=sk-hud-...   (or: export HUD_API_KEY=...)
#     init    : hud init my-env             (scaffold an environment)
# ─────────────────────────────────────────────────────────────────────────────

# Fireworks (Teacher RFT + serving) — pip install --pre fireworks-ai eval-protocol; firectl signin
FIREWORKS_API_KEY=

# Modal (parallel Player training) — pip install modal; modal token new
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# HUD (env packaging / traces) — pip install hud-python; hud init
HUD_API_KEY=

# Anthropic (baseline / build-time Claude) — optional
ANTHROPIC_API_KEY=

# OpenAI (sponsor, optional)
OPENAI_API_KEY=
